# Linksys WRT1900ACS v2 Rev.A00 (Shelby) default environment

baudrate=115200
bootdelay=3
autoload=no
ipaddr=192.168.1.1
serverip=192.168.1.254
netmask=255.255.255.0
ethprime=lan1
ethrotate=no
switch_handoff=probe
preboot=
loadaddr=0x02000000
defaultLoadAddr=0x02000000
fdtaddr=0x03000000
scriptaddr=0x03100000
fdt_high=0xffffffff
initrd_high=0xffffffff
env_schema=wrt1900acsv2-v7.0.0

# Linksys dual-firmware NAND layout used by this port
mtdids=nand0=armada-nand
mtdparts=mtdparts=armada-nand:2048K(uboot)ro,256K(u_env),256K(s_env),1m@9m(devinfo),40m@10m(kernel),34m@16m(rootfs),40m@50m(alt_kernel),34m@56m(alt_rootfs),80m@10m(ubifs),-@90m(syscfg)

priKernAddr=0x00a00000
priKernSize=0x00600000
priFwSize=0x02800000
altKernAddr=0x03200000
altKernSize=0x00600000
altFwSize=0x02800000

boot_part=1
boot_part_ready=3
auto_recovery=modern
upgrade_available=0
bootcount=0
bootlimit=3
firmwareName=shelby.img
image_name=shelby.img
ubootName=u-boot-wrt1900acsv2-v7.0.0-final-nand-v2026.07.kwb

set_slot1=linksys slot 1; linksys select
set_slot2=linksys slot 2; linksys select
select_slot=linksys select
boot_kernel_atags=iminfo ${loadaddr}; bootm ${loadaddr}
boot_kernel_fdt=iminfo ${loadaddr}; bootm ${loadaddr} - ${fdtcontroladdr}
boot_kernel=run boot_kernel_atags
nandboot=setenv bootargs console=ttyS0,115200 root=/dev/mtdblock5 ro rootdelay=1 rootfstype=jffs2 earlyprintk ${mtdparts}; nand read ${loadaddr} ${priKernAddr} ${priKernSize}; run boot_kernel
altnandboot=setenv bootargs console=ttyS0,115200 root=/dev/mtdblock7 ro rootdelay=1 rootfstype=jffs2 earlyprintk ${mtdparts}; nand read ${loadaddr} ${altKernAddr} ${altKernSize}; run boot_kernel
bootcmd=linksys boot
altbootcmd=linksys fallback

# Recovery paths
netboot=tftpboot ${loadaddr} ${image_name}; bootm ${loadaddr}
usbboot=usb start; load usb 0:1 ${loadaddr} /${image_name}; bootm ${loadaddr}
sataboot=scsi scan; load scsi 0:1 ${loadaddr} /${image_name}; bootm ${loadaddr}
mmcboot=mmc rescan; load mmc 0:1 ${loadaddr} /${image_name}; bootm ${loadaddr}

# Firmware update helpers. NAND writes still require the one-boot token.
check_fw_size=if itest ${filesize} -gt ${priFwSize}; then echo Firmware too large: ${filesize}; false; else true; fi
flash_pri_image=run check_fw_size; nand erase ${priKernAddr} ${priFwSize}; nand write ${loadaddr} ${priKernAddr} ${filesize}
flash_alt_image=run check_fw_size; nand erase ${altKernAddr} ${altFwSize}; nand write ${loadaddr} ${altKernAddr} ${filesize}
update_pri_image=tftpboot ${loadaddr} ${firmwareName}; run flash_pri_image
update_alt_image=tftpboot ${loadaddr} ${firmwareName}; run flash_alt_image
update_both_images=tftpboot ${loadaddr} ${firmwareName}; run flash_pri_image; run flash_alt_image

# U-Boot load/check/install helpers. The installer validates and verifies.
load_uboot_usb=usb start; load usb 0:1 ${loadaddr} /${ubootName}
load_uboot_tftp=tftpboot ${loadaddr} ${ubootName}
check_uboot=linksys uboot check ${loadaddr} ${filesize}
install_uboot=linksys uboot install ${loadaddr} ${filesize}

# Backup helpers. Use tftpput or save after setting filesize.
backup_uboot=nand read ${loadaddr} 0x00000000 0x00200000; setenv filesize 0x00200000
backup_uenv=nand read ${loadaddr} 0x00200000 0x00040000; setenv filesize 0x00040000
backup_senv=nand read ${loadaddr} 0x00240000 0x00040000; setenv filesize 0x00040000
backup_devinfo=nand read ${loadaddr} 0x00900000 0x00100000; setenv filesize 0x00100000
