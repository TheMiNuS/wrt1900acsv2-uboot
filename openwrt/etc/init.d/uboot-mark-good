START=99
USE_PROCD=1

start_service() {
    command -v fw_printenv >/dev/null 2>&1 || return 0
    command -v fw_setenv >/dev/null 2>&1 || return 0

    upgrade_available="$(fw_printenv -n upgrade_available 2>/dev/null)" || return 0
    [ "$upgrade_available" = "1" ] || return 0

    script="/tmp/uboot-mark-good.$$"
    trap 'rm -f "$script"' EXIT INT TERM
    cat > "$script" <<'EOF'
upgrade_available 0
bootcount 0
boot_part_ready 3
EOF

    fw_setenv -s "$script"
}
